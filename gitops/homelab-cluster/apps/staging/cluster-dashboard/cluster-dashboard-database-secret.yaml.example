# Encrypt with sops before Flux apply. Do not commit plaintext.
# sops --encrypt --encrypted-regex '^(data|stringData)$' \
#   gitops/homelab-cluster/apps/staging/cluster-dashboard/cluster-dashboard-database-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: cluster-dashboard-database
  namespace: cluster-dashboard
type: Opaque
stringData:
  username: dashboard
  password: CHANGE_ME
  uri: postgresql+psycopg://dashboard:CHANGE_ME@homelab-postgres-rw.database.svc.cluster.local:5432/dashboard
  secret-key: CHANGE_ME
